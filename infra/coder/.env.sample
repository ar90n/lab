# このファイルを .env にコピーし、PASSWORD を実際の値に置き換える。
#   cp .env.sample .env && chmod 600 .env
#   openssl rand -hex 24    # パスワード生成用
#
# .env は docker compose の env-file と systemd の EnvironmentFile の
# 両方から読まれる。KEY=value 形式を崩さないこと（引用符やスペースを入れない）。

POSTGRES_USER=coder
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=coder

# coder server -> postgres コンテナ。POSTGRES_PASSWORD と同じ値を埋めること。
CODER_PG_CONNECTION_URL=postgres://coder:CHANGE_ME@127.0.0.1:5432/coder?sslmode=disable

# ワークスペースのエージェントとブラウザの両方から到達できる URL。
# localhost / 127.0.0.1 は使えない。
CODER_ACCESS_URL=http://slime.tail38ea2.ts.net:7080
CODER_HTTP_ADDRESS=0.0.0.0:7080

# --- 家庭用チューニング (single user, LAN/tailnet only) ---
# ブラウザセッションの有効期間。既定 24h では毎日ログインが要る。
CODER_SESSION_DURATION=720h
# session duration は OAuth refresh lifetime より厳密に短い必要がある。
# 両方の既定が 720h なので、こちらを引き上げないと起動に失敗する。
CODER_DEFAULT_OAUTH_REFRESH_LIFETIME=1440h
# 匿名利用データの Coder 社への送信を停止。
# 副作用: セキュリティ問題の通知も届かなくなる（起動時に warn が出る）。
CODER_TELEMETRY_ENABLE=false
# AI Gateway のインメモリインスタンス。aibridge は not_entitled で、AI キーも
# 設定していないので起動する意味がない。
CODER_AI_GATEWAY_ENABLED=false
# ダッシュボードから AI Tasks を隠す。
CODER_HIDE_AI_TASKS=true
# 「Sign in with GitHub」を無効化。内蔵のパスワード認証のみを使うため、
# LAN に晒しているサインイン経路を1つ減らす。
# (workspace から private repo を clone するための external auth とは別物で、
#  そちらは CODER_EXTERNAL_AUTH_GITHUB_DEFAULT_PROVIDER_ENABLE。有効のまま残す)
CODER_OAUTH2_GITHUB_DEFAULT_PROVIDER_ENABLE=false
