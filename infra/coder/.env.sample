# このファイルを .env にコピーし、PASSWORD を実際の値に置き換える。
#   cp .env.sample .env && chmod 600 .env
#   openssl rand -hex 24    # パスワード生成用
#
# .env は docker compose の env-file と systemd の EnvironmentFile の
# 両方から読まれる。KEY=value 形式を崩さないこと（引用符やスペースを入れない）。

POSTGRES_USER=coder
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=coder

# coder server -> postgres コンテナ。POSTGRES_PASSWORD と同じ値を埋めること。
CODER_PG_CONNECTION_URL=postgres://coder:CHANGE_ME@127.0.0.1:5432/coder?sslmode=disable

# ワークスペースのエージェントとブラウザの両方から到達できる URL。
# localhost / 127.0.0.1 は使えない。
CODER_ACCESS_URL=http://slime.tail38ea2.ts.net:7080
CODER_HTTP_ADDRESS=0.0.0.0:7080
