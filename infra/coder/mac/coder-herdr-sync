#!/usr/bin/env python3
"""coder-herdr-sync — Coder のワークスペースを Mac の herdr サイドバーに揃える。

2つのことをする。

1. hosts.toml の生成 — herdr-mirror にどのホストを見せるかを Coder から導出する。
   このファイルは設定ではなく生成物で、人が編集する箇所は無い。
2. リモートの herdr workspace の確保 — herdr の workspace は最後の pane が
   終了すると消える (シェルと寿命を共にする)。そうなるとサイドバーから項目が
   消えたまま戻らないので、0 個になっているリモートに作り直す。

ワークスペースの一覧を持っているのは Coder サーバーだけで、取得手段は
`coder list` の1つしかない。~/.ssh/config は `Host coder.*` のワイルドカードで、
名前を1つも含まないため列挙には使えない (接頭辞の取得にだけ使う)。

  coder-herdr-sync          実行する
  coder-herdr-sync --all    停止中のワークスペースも hosts.toml に含める
"""
import argparse
import difflib
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

STATE = Path.home() / ".local/state/herdr-mirror"
SSH_CONFIG = Path.home() / ".ssh/config"
FALLBACK_DEST = Path.home() / ".config/herdr-mirror/hosts.toml"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def coder_bin():
    return shutil.which("coder") or str(Path.home() / ".local/share/mise/shims/coder")


def workspaces(include_stopped):
    """running なワークスペース名。取得に失敗したら例外を投げる (既存を壊さないため)。"""
    out = run([coder_bin(), "list", "-o", "json"])
    if out.returncode != 0:
        raise RuntimeError(f"coder list に失敗:\n{out.stderr.strip()}")
    names = []
    for w in json.loads(out.stdout):
        b = w["latest_build"]
        running = b["transition"] == "start" and b.get("status") == "running"
        if running or include_stopped:
            names.append(w["name"])
    return sorted(names)


def ssh_prefix():
    """coder config-ssh が書いた --ssh-host-prefix の値。決め打ちしない。

    既定は "coder." だが coder config-ssh のオプションで変えられる。変えられた時に
    target が食い違って静かに壊れるのを避ける。
    """
    try:
        text = SSH_CONFIG.read_text()
    except OSError:
        return "coder."
    m = re.search(r"--ssh-host-prefix\s+(\S+)", text)
    return m.group(1) if m else "coder."


def destination():
    """デーモンが実際に読むパス。決め打ちしない。

    設定はディレクトリ3箇所を順に探して先に見つかったものが勝つ。決め打ちすると、
    探索順で先のディレクトリに hosts.toml が置かれた瞬間、読まれないファイルを
    更新し続けることになる (しかもエラーは出ない)。
    """
    out = run(["herdr-mirror", "status"])
    m = re.search(r"^config:\s*(.+)$", out.stdout, re.M)
    return Path(m.group(1).strip()) if m else FALLBACK_DEST


def render(names, prefix):
    """生成物。同じ入力からは必ず同じバイト列を出す (差分判定が意味を持つように)。

    キーはワークスペース名そのまま。TOML の bare key は - を許す。
    サイドバーの表示名 (prefix) は既定値がキーなので書かない。
    """
    out = ["# generated by coder-herdr-sync — edit は上書きされる\n",
           "always_control = true\n",
           # リモートの workspace/pane が消えたことをこの間隔で検知する。既定の 60 は
           # シェルを exit してからサイドバーの項目が消えるまで最大 1 分かかって遅い。
           # ポーリングは張りっぱなしの SSH 接続の上で行われるので新規接続は発生しない。
           # 下限は 5 (config.poll_seconds.max(5) でクランプされる)。
           "poll_seconds = 5\n"]
    for name in names:
        out.append(f'\n[hosts.{name}]\ntarget = "{prefix}{name}"\n')
    return "".join(out)


def write_atomic(dest, text):
    """一時ファイル + rename。デーモンの起動と重なっても切れたファイルを読ませない。"""
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=".hosts.toml.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, dest)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def restart_daemon():
    """設定を読ませる唯一の手段。herdr-mirror にリロードは無い。

    pause は使わない: マーカー (daemon.paused) を立ててから消す順序になるため、
    途中で失敗すると停止状態で取り残される。kill して ensure に任せる。
    """
    if (STATE / "daemon.paused").exists():
        print("daemon.paused があるので入れ替えを見送る（意図的な停止と判断）")
        return
    try:
        pid = int((STATE / "daemon.pid").read_text().strip())
        os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    r = run(["herdr-mirror", "ensure"])
    print(r.stdout.strip() or "daemon を入れ替えた")


# --- リモートの herdr workspace ---------------------------------------------
#
# ssh coder.<name> ではなく coder ssh <name> を使う。どちらも同じ場所に着地するが、
# coder ssh は ~/.ssh/config と接頭辞の解決に依存しない。すでに coder list で CLI を
# 使っているので、この処理の依存先が「coder CLI と認証」の1つに収まる。
#
# ただし --disable-autostart を明示的に渡すこと。この抑止は ~/.ssh/config の
# ProxyCommand に埋め込まれているので ssh coder.<name> 経由でしか効かず、coder ssh を
# 直接呼ぶと停止中のワークスペースを起動してしまう (reason: ssh_connection を実測)。
# 停止したものは停止したままにする、という運用と正面から衝突する。
#
# 渡すフラグはテンプレートの startup_script と同じ --label main --no-focus に --cwd。
# コンテナ起動時に作られたものと、ここで作り直したものを区別できない状態に保つ。
#
# --cwd は省略できない。herdr workspace create はソケット API 越しの呼び出しで、
# 呼び出し元の cwd はサーバーに伝わらないため、省くと pane が $HOME で開く
# (実測: coder ssh が workdir に着地していても /home/coder になった)。
# ただし値は決め打ちせず $PWD をリモートで展開させる。coder ssh は
# coder_agent.dir (= workdir パラメータ) に着地するので、作業ディレクトリの
# 出所は Coder 側の1箇所に保たれる。

def remote_workspace_count(name):
    """リモートの herdr workspace 数。到達できなければ None。"""
    out = run([coder_bin(), "ssh", "--disable-autostart", name, "--",
               "herdr workspace list"])
    if out.returncode != 0:
        return None
    try:
        return len(json.loads(out.stdout)["result"]["workspaces"])
    except (ValueError, KeyError):
        return None


def create_remote_workspace(name):
    return run([coder_bin(), "ssh", "--disable-autostart", name, "--",
                'herdr workspace create --cwd "$PWD" --label main --no-focus'])


def ensure_remote_workspaces(names):
    """workspace が 0 個のリモートに作る。到達できないものはスキップする。

    coder list を取ってから実行するまでの間に停止した、コンテナ起動直後で herdr が
    まだ上がっていない、といった理由で到達できないことは普通に起こる。1台の失敗で
    全体を止めない。
    """
    w = max((len(n) for n in names), default=0)
    for name in names:
        count = remote_workspace_count(name)
        if count is None:
            print(f"  {name:<{w}}  到達できない — スキップ")
        elif count > 0:
            print(f"  {name:<{w}}  workspace {count} 個 — そのまま")
        elif create_remote_workspace(name).returncode == 0:
            print(f"  {name:<{w}}  workspace 0 個 — 作成した")
        else:
            print(f"  {name:<{w}}  workspace 0 個 — 作成に失敗", file=sys.stderr)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--all", action="store_true",
                    help="停止中のワークスペースも hosts.toml に含める")
    args = ap.parse_args()

    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "sync.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("別の coder-herdr-sync が実行中")

    try:
        names = workspaces(args.all)
    except RuntimeError as e:
        # 取得に失敗した場合は既存の hosts.toml に触れない。
        # 「0件だった」とは区別する: 全部停止していれば 0 件で正しく書く。
        sys.exit(str(e))

    dest = destination()
    new = render(names, ssh_prefix())
    old = dest.read_text() if dest.exists() else ""

    if new == old:
        # 差分が無ければデーモンには触らない。無駄にミラーを数秒凍結させないため。
        print(f"変更なし ({len(names)} hosts) — {dest}")
    else:
        sys.stdout.writelines(difflib.unified_diff(
            old.splitlines(True), new.splitlines(True), f"{dest} (現在)", "(生成)"))
        write_atomic(dest, new)
        print(f"書き込み: {dest}")
        restart_daemon()

    ensure_remote_workspaces(names)


if __name__ == "__main__":
    main()
