#!/usr/bin/env python3
"""pane-url — herdr の pane に表示されている URL を、折り返しを繋いで取り出す。

ターミナルの折り返しで切れた URL はクリックしても途中までしか開かない。
マウス選択も herdr のミラー pane ではサイドバーごと選んでしまって使えない。
このコマンドは pane の内容を unwrapped で読み、URL を復元して表示・オープンする。

  pane-url                      # ローカル herdr のフォーカス中の pane から
  pane-url w9:p1                # ローカルの pane を指定
  pane-url coder.hpt-sd-mux     # リモートホストのフォーカス中の pane から
  pane-url coder.hpt-sd-mux w9:p1
  pane-url ... --open           # 見つかった URL をブラウザで開く
  pane-url ... --copy           # クリップボードにコピー
"""
import json
import re
import subprocess
import sys

# URL に使える文字 (RFC 3986 の unreserved + reserved + %)
URL_CHARS = r"[A-Za-z0-9:/?#\[\]@!$&'()*+,;=._~%-]+"


def run(host, args):
    cmd = ["herdr", *args]
    if host:
        cmd = ["ssh", "-o", "BatchMode=yes", host, " ".join(cmd)]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f"failed: {' '.join(cmd)}\n{p.stderr.strip()}")
    return p.stdout


def focused_pane(host):
    data = json.loads(run(host, ["pane", "list"]))
    for pane in data["result"]["panes"]:
        if pane.get("focused"):
            return pane["pane_id"]
    sys.exit("no focused pane found")


def main():
    argv = [a for a in sys.argv[1:] if not a.startswith("--")]
    flags = {a for a in sys.argv[1:] if a.startswith("--")}

    host = None
    pane = None
    for arg in argv:
        # "w9:p1" のような pane id 以外はホスト名とみなす
        if re.fullmatch(r"w\d+:p\d+", arg):
            pane = arg
        else:
            host = arg
    if pane is None:
        pane = focused_pane(host)

    # recent-unwrapped でソフトラップは繋がるが、アプリが自前で折り返した
    # ハードな改行は残るため、URL 候補の中の改行はこちらで落とす。
    text = run(host, ["pane", "read", pane, "--source", "recent-unwrapped",
                      "--lines", "300"])

    urls = []
    for m in re.finditer(r"https?://", text):
        joined = text[m.start():m.start() + 4000].replace("\n", "")
        url = re.match(URL_CHARS, joined).group(0)
        if url not in urls:
            urls.append(url)

    if not urls:
        sys.exit(f"no URL found in {pane}")

    for url in urls:
        print(url)

    if "--open" in flags:
        subprocess.run(["open", urls[-1]])
    if "--copy" in flags:
        subprocess.run(["pbcopy"], input=urls[-1], text=True)


if __name__ == "__main__":
    main()
